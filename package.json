{
    "name": "beavs-pad-palace",
    "version": "1.0.0",
    "description": "Beavs Pad Palace - Housing Platform",
    "private": true,
    "workspaces": [
        "frontend",
        "backend",
        "mobile"
    ],
    "scripts": {
        "dev": "echo 'Please run from specific directory: cd frontend && npm run dev OR cd backend && npm run dev'",
        "dev:frontend": "cd frontend && npm run dev",
        "dev:backend": "cd backend && npm run dev",
        "dev:mobile": "cd mobile && npx expo start",
        "install:all": "cd frontend && npm install && cd ../backend && npm install && cd ../mobile && npm install"
    },
    "overrides": {
        "@heroui/theme": "2.2.11",
        "@heroui/system": "2.2.6",
        "@heroui/system-rsc": "2.1.4"
    }
}